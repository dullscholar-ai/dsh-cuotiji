{
  "name": "@dullscholar-ai/dsh-cuotiji",
  "version": "1.0.1",
  "description": "错题本 DSH 插件：上传试卷/作业，按学科·章节·知识点归集错题，双轨保留题面与解析，导出一题一页的错题集。",
  "type": "module",
  "license": "MIT",
  "author": "dullscholar-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/dullscholar-ai/dsh-cuotiji.git"
  },
  "homepage": "https://github.com/dullscholar-ai/dsh-cuotiji",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "错题本",
    "错题集",
    "ocr",
    "education",
    "pdf"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
